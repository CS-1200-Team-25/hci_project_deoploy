# Server only: never use a VITE_ prefix for this secret.
GEMINI_API_KEY=
# Optional second key; requests alternate between the configured keys.
GEMINI_API_KEY_2=
GEMINI_MODEL=gemini-3.5-flash-lite
GENERATION_TIMEOUT_MS=15000
APP_ORIGIN=http://localhost:5173
# Local listener defaults; Render sets HOST=0.0.0.0 and supplies PORT.
HOST=127.0.0.1
PORT=8787
