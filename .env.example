# Server only: never use a VITE_ prefix for this secret.
LLM_PROVIDER=gemini
GEMINI_API_KEY=
LLM_MODEL=gemini-2.5-flash-lite
# Optional common credential override: LLM_API_KEY=
# Other adapters: openai or openai-compatible (set LLM_MODEL and LLM_API_KEY).
# Compatible endpoints require a base URL including the API prefix, e.g.:
# LLM_BASE_URL=http://127.0.0.1:11434/v1
GENERATION_TIMEOUT_MS=15000
APP_ORIGIN=http://localhost:5173
